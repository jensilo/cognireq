{
  "version": "2",
  "sql": [
    {
      "engine": "postgresql",
      "schema": "./pkg/db/schema.sql",
      "queries": "./pkg/db/query.sql",
      "gen": {
        "go": {
          "package": "db",
          "out": "./pkg/db",
          "sql_package": "pgx/v5",
          "emit_empty_slices": true,
          "emit_json_tags": true,
          "emit_interface": true,
          "emit_prepared_queries": true,
          "overrides": [
            {
              "db_type": "uuid",
              "nullable": true,
              "go_type": {
                "import": "github.com/google/uuid",
                "type": "UUID"
              }
            },
            {
              "db_type": "uuid",
              "nullable": false,
              "go_type": {
                "import": "github.com/google/uuid",
                "type": "UUID"
              }
            }
          ]
        }
      }
    }
  ]
}